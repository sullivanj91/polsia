# ─── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_KEY=your-secure-api-key
SANDBOX_MODE=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://polsia:polsia_password@postgres:5432/polsia
POSTGRES_USER=polsia
POSTGRES_PASSWORD=polsia_password
POSTGRES_DB=polsia

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/app/data/chroma

# ─── Claude Code CLI (no API key — uses OAuth stored at ~/.claude) ────────────
CLAUDE_CLI_PATH=/usr/local/bin/claude
CLAUDE_CLI_MOCK=
CLAUDE_CLI_MOCK_RESPONSE=

# ─── Twitter / X ──────────────────────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ─── Google Ads ───────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ─── Meta Ads ─────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# ─── Email ────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.
SENDGRID_FROM_EMAIL=agent@yourcompany.com
IMAP_HOST=imap.gmail.com
IMAP_USER=support@yourcompany.com
IMAP_PASSWORD=

# ─── Prospect Finding ─────────────────────────────────────────────────────────
HUNTER_IO_API_KEY=

# ─── Web Search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-

# ─── Code Deployment ──────────────────────────────────────────────────────────
GITHUB_TOKEN=github_pat_
VERCEL_TOKEN=
RAILWAY_API_KEY=

# ─── Stripe (Finance Agent) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_test_

# ─── Scheduler ────────────────────────────────────────────────────────────────
MORNING_CYCLE_HOUR=6
EVENING_CYCLE_HOUR=20

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost
